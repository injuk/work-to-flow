{
	"name": "work-to-flow",
	"version": "1.0.0",
	"description": "",
	"type": "module",
	"main": "dist/index.js",
	"scripts": {
		"build": "tsc",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:seed": "tsx infra/seed/seed.ts",
		"db:setup": "pnpm db:migrate && pnpm db:seed",
		"test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --selectProjects unit",
		"test:integration": "node --experimental-vm-modules node_modules/jest/bin/jest.js --selectProjects integration",
		"test:all": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
		"test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --selectProjects unit --coverage",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write \"src/**/*.{ts,tsx,json}\" \"test/**/*.{ts,tsx,json}\" \"*.{ts,mjs,json,md}\"",
		"format:check": "prettier --check \"src/**/*.{ts,tsx,json}\" \"test/**/*.{ts,tsx,json}\" \"*.{ts,mjs,json,md}\""
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"dependencies": {
		"drizzle-orm": "^0.45.2",
		"hashids": "^2.3.0",
		"mysql2": "^3.11.5",
		"nanoid": "^5.1.11",
		"uuid": "^13.0.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@aws-sdk/client-lambda": "^3.1045.0",
		"@eslint/js": "^9.39.4",
		"@types/jest": "^30.0.0",
		"@types/node": "^22.10.1",
		"csv-parse": "^6.2.1",
		"dotenv": "^16.4.7",
		"drizzle-kit": "^0.31.10",
		"eslint": "^9.39.4",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-prettier": "^5.5.5",
		"jest": "^30.4.2",
		"prettier": "^3.8.3",
		"ts-jest": "^29.4.9",
		"tsx": "^4.19.2",
		"typescript": "^5.7.2",
		"typescript-eslint": "^8.59.2"
	}
}
